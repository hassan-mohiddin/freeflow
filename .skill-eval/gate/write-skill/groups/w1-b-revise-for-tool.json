  },
  "fixture": ".skill-eval/skill-family/fixtures/w1-b",
  "tools": ["read", "write", "ls", "find"],
  "configuration": {
    "extends": "../../../skill-family/configuration.json",
    "subject": {
      "kind": "skill",
      "target": 0,
      "context": [],
