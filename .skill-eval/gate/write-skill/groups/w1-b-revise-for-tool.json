        "kind": "git",
        "ref": "51998038825153582abda2ee1b3249f18342871f"
      }
    }
  },
  "arms": {
    "base": {
      "subject": {
        "source": {
          "kind": "git",
          "ref": "3415a8a2f4158e17fe605c5378f18eb4e8c08ed5"
        }
      }
    },
    "head": {}
  },
  "component": ["subject.source"],
  "expectations": [
    {
