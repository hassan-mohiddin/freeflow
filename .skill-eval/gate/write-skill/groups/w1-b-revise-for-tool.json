    },
    {
      "id": "head-guard-sentence-removed",
      "variant": "head",
      "comparison": "guard-sentence-removed",
      "kind": "file-text",
      "path": "skill/SKILL.md",
      "expect": "not-contains",
      "value": "Never hand-edit `build-manifest.generated.json`"
    }
  ],
  "review_questions": [
    "Did the revision remove the Rule that the tool now enforces, and keep a guard only for a path the tool does not refuse?",
    "Did the revision leave the skill's other steps and Rules as they were, apart from what the tooling change requires?",
    "Does the revised skill still tell the agent to run the tests and report the result?"
