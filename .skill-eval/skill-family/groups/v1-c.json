{
  "schema_version": 2,
  "kind": "group",
  "id": "v1-c-model-question-design",
  "type": "body",
  "input": {
    "prompt": "Read `task/setup.md`. The support team asks whether to move the ticket summarizer to the larger model. Write `design.md`: an evaluation that could answer that question. Do not run anything. Write only `design.md`."
  },
  "fixture": ".skill-eval/skill-family/fixtures/v1-c",
  "tools": [
    "read",
    "write",
    "ls",
    "find"
  ],
  "configuration": {
    "extends": "../configuration.json",
    "subject": {
      "kind": "skill",
      "target": 0,
      "context": []
    }
  },
  "arms": {
    "baseline": {
      "subject": {
        "source": {
          "kind": "git",
          "ref": "3415a8a2f4158e17fe605c5378f18eb4e8c08ed5"
        },
        "skills": [
          "skills/evaluate-skill"
        ]
      }
    },
    "candidate": {
      "subject": {
        "source": {
          "kind": "git",
          "ref": "b78e8fd9f7acc8209a831aaef6f576d1ca6508c8"
        },
        "skills": [
          "skills/evaluate-behavior"
        ]
      }
    }
  },
  "component": [
    "subject.source",
    "subject.skills"
  ],
  "expectations": [
    {
      "id": "baseline-only-design-written",
      "variant": "baseline",
      "comparison": "only-design-written",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": [
        "design.md"
      ]
    },
    {
      "id": "candidate-only-design-written",
      "variant": "candidate",
      "comparison": "only-design-written",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": [
        "design.md"
      ]
    },
    {
      "id": "baseline-design-exists",
      "variant": "baseline",
      "comparison": "design-exists",
      "kind": "path",
      "path": "design.md",
      "expect": "exists"
    },
    {
      "id": "candidate-design-exists",
      "variant": "candidate",
      "comparison": "design-exists",
      "kind": "path",
      "path": "design.md",
      "expect": "exists"
    }
  ],
  "review_questions": [
    "Did the design make the model the component under test, with the model in use as the baseline?",
    "Did the design check that each run used the declared model (delivery) or what its summaries did (behavior), rather than assume it?",
    "Did the design leave out any check of whether a skill activated, since the question does not involve a skill?"
