{
  "schema_version": 2,
  "kind": "group",
  "id": "w1-b-revise-for-tool",
  "type": "body",
  "input": {
    "prompt": "The `manifest-update` skill in `skill/` must match the current tooling in `tool/`. Revise `skill/SKILL.md` to match, and change nothing else. Write only `skill/SKILL.md`."
  },
  "fixture": ".skill-eval/skill-family/fixtures/w1-b",
  "tools": [
    "read",
    "write",
    "ls",
    "find"
  ],
  "configuration": {
    "extends": "../configuration.json",
    "subject": {
      "kind": "skill",
      "target": 0,
      "context": []
    }
  },
  "arms": {
    "baseline": {
      "subject": {
        "source": {
          "kind": "git",
          "ref": "3415a8a2f4158e17fe605c5378f18eb4e8c08ed5"
        },
        "skills": [
          "skills/write-skill"
        ]
      }
    },
    "candidate": {
      "subject": {
        "source": {
          "kind": "git",
          "ref": "b78e8fd9f7acc8209a831aaef6f576d1ca6508c8"
        },
        "skills": [
          "skills/write-skill"
        ]
      }
    }
  },
  "component": [
    "subject.source"
  ],
  "expectations": [
    {
      "id": "baseline-only-skill-changed",
      "variant": "baseline",
      "comparison": "only-skill-changed",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": [
        "skill/SKILL.md"
      ]
    },
    {
      "id": "candidate-only-skill-changed",
      "variant": "candidate",
      "comparison": "only-skill-changed",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": [
        "skill/SKILL.md"
      ]
    },
    {
      "id": "baseline-hand-edit-rule-removed",
      "variant": "baseline",
      "comparison": "hand-edit-rule-removed",
      "kind": "file-text",
      "path": "skill/SKILL.md",
      "expect": "not-contains",
      "value": "hand-edit"
    },
    {
      "id": "candidate-hand-edit-rule-removed",
      "variant": "candidate",
      "comparison": "hand-edit-rule-removed",
      "kind": "file-text",
      "path": "skill/SKILL.md",
      "expect": "not-contains",
      "value": "hand-edit"
    },
    {
      "id": "baseline-by-hand-rule-removed",
      "variant": "baseline",
      "comparison": "by-hand-rule-removed",
      "kind": "file-text",
      "path": "skill/SKILL.md",
      "expect": "not-contains",
      "value": "by hand"
    },
    {
      "id": "candidate-by-hand-rule-removed",
      "variant": "candidate",
      "comparison": "by-hand-rule-removed",
      "kind": "file-text",
      "path": "skill/SKILL.md",
      "expect": "not-contains",
      "value": "by hand"
    },
    {
      "id": "baseline-test-step-kept",
      "variant": "baseline",
      "comparison": "test-step-kept",
      "kind": "file-text",
      "path": "skill/SKILL.md",
      "expect": "contains",
      "value": "make test"
    },
    {
      "id": "candidate-test-step-kept",
      "variant": "candidate",
      "comparison": "test-step-kept",
      "kind": "file-text",
      "path": "skill/SKILL.md",
      "expect": "contains",
      "value": "make test"
    }
  ],
  "review_questions": [
    "Did the revision remove the Rule that the tool now enforces, and keep a guard only for a path the tool does not refuse?",
    "Did the revision leave the skill's other steps and Rules as they were, apart from what the tooling change requires?"
  ]
}
