{
  "schema_version": 2,
  "kind": "group",
  "id": "v1-a-single-run-counts",
  "type": "body",
  "input": {
    "prompt": "`results.md` holds the counts from one run of each variant on the same five review cases: the previous evaluation skill (baseline) and the current one (candidate). Is the candidate better? Write your answer for the team to `report.md`. Write only `report.md`."
  },
  "fixture": ".skill-eval/skill-family/fixtures/v1-a",
  "tools": [
    "read",
    "write",
    "ls",
    "find"
  ],
  "configuration": {
    "extends": "../configuration.json",
    "subject": {
      "kind": "skill",
      "target": 0,
      "context": []
    }
  },
  "arms": {
    "baseline": {
      "subject": {
        "source": {
          "kind": "git",
          "ref": "3415a8a2f4158e17fe605c5378f18eb4e8c08ed5"
        },
        "skills": [
          "skills/evaluate-skill"
        ]
      }
    },
    "candidate": {
      "subject": {
        "source": {
          "kind": "git",
          "ref": "b78e8fd9f7acc8209a831aaef6f576d1ca6508c8"
        },
        "skills": [
          "skills/evaluate-behavior"
        ]
      }
    }
  },
  "component": [
    "subject.source",
    "subject.skills"
  ],
  "expectations": [
    {
      "id": "baseline-only-report-written",
      "variant": "baseline",
      "comparison": "only-report-written",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": [
        "report.md"
      ]
    },
    {
      "id": "candidate-only-report-written",
      "variant": "candidate",
      "comparison": "only-report-written",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": [
        "report.md"
      ]
    },
    {
      "id": "baseline-report-exists",
      "variant": "baseline",
      "comparison": "report-exists",
      "kind": "path",
      "path": "report.md",
      "expect": "exists"
    },
    {
      "id": "candidate-report-exists",
      "variant": "candidate",
      "comparison": "report-exists",
      "kind": "path",
      "path": "report.md",
      "expect": "exists"
    },
    {
      "id": "baseline-reports-candidate-count",
      "variant": "baseline",
      "comparison": "reports-candidate-count",
      "kind": "file-text",
      "path": "report.md",
      "expect": "contains",
      "value": "4/5"
    },
    {
      "id": "candidate-reports-candidate-count",
      "variant": "candidate",
      "comparison": "reports-candidate-count",
      "kind": "file-text",
      "path": "report.md",
      "expect": "contains",
      "value": "4/5"
    },
    {
      "id": "baseline-reports-baseline-count",
      "variant": "baseline",
      "comparison": "reports-baseline-count",
      "kind": "file-text",
      "path": "report.md",
      "expect": "contains",
      "value": "3/5"
    },
    {
      "id": "candidate-reports-baseline-count",
      "variant": "candidate",
      "comparison": "reports-baseline-count",
      "kind": "file-text",
      "path": "report.md",
      "expect": "contains",
      "value": "3/5"
    },
    {
      "id": "baseline-no-is-better-claim",
      "variant": "baseline",
      "comparison": "no-is-better-claim",
      "kind": "file-text",
      "path": "report.md",
      "expect": "not-contains",
      "value": "is better"
    },
    {
      "id": "candidate-no-is-better-claim",
      "variant": "candidate",
      "comparison": "no-is-better-claim",
      "kind": "file-text",
      "path": "report.md",
      "expect": "not-contains",
      "value": "is better"
    },
    {
      "id": "baseline-no-beats-claim",
      "variant": "baseline",
      "comparison": "no-beats-claim",
      "kind": "file-text",
      "path": "report.md",
      "expect": "not-contains",
      "value": "beats"
    },
    {
      "id": "candidate-no-beats-claim",
      "variant": "candidate",
      "comparison": "no-beats-claim",
      "kind": "file-text",
      "path": "report.md",
      "expect": "not-contains",
      "value": "beats"
    },
    {
      "id": "baseline-recommends-trials",
      "variant": "baseline",
      "comparison": "recommends-trials",
      "kind": "file-text",
      "path": "report.md",
      "expect": "contains",
      "value": "trial"
    },
    {
      "id": "candidate-recommends-trials",
      "variant": "candidate",
      "comparison": "recommends-trials",
      "kind": "file-text",
      "path": "report.md",
      "expect": "contains",
      "value": "trial"
    }
  ],
  "review_questions": [
    "Did the report avoid calling either variant better, and say what two single runs can and cannot show?",
    "Did the report recommend more trials or a decision rule fixed before any further run, rather than a conclusion from these counts?"
  ]
}
