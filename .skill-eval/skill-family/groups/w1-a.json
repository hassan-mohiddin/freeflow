{
  "schema_version": 2,
  "kind": "group",
  "id": "w1-a-choose-changes",
  "type": "body",
  "input": {
    "prompt": "Revise the `handoff-notes` skill in `skill/` using the evidence in `evidence/`. Five candidate changes follow. For each one, decide keep or drop. Keep means you make a change to the skill's text for it. Drop means you make no change to the skill's text for it. Write `changes.md` with exactly five lines, one per candidate in the order given. Each line starts with the candidate's ID, then `: keep` or `: drop`, then the reason, for example `X1: keep - reason`. Write only `changes.md`; leave `skill/` unchanged.\n\n- C1: Add: name the branch exactly as `git branch --show-current` prints it.\n- C2: Add: check that every link in the handoff resolves before finishing.\n- C3: Add: leave out conversation details the next session does not need.\n- C4: Add: list each open decision with its owner and the option you recommend.\n- C5: Add: open with the current state; put the history of the session last."
  },
  "fixture": ".skill-eval/skill-family/fixtures/w1-a",
  "tools": ["read", "write", "ls", "find"],
  "configuration": {
    "extends": "../configuration.json",
    "subject": {
      "kind": "skill",
      "target": 0,
      "context": []
    }
  },
  "arms": {
    "baseline": {
      "subject": {
        "source": {
          "kind": "git",
          "ref": "3415a8a2f4158e17fe605c5378f18eb4e8c08ed5"
        },
        "skills": ["skills/write-skill"]
      }
    },
    "candidate": {
      "subject": {
        "source": {
          "kind": "git",
          "ref": "b78e8fd9f7acc8209a831aaef6f576d1ca6508c8"
        },
        "skills": ["skills/write-skill"]
      }
    }
  },
  "component": ["subject.source"],
  "expectations": [
