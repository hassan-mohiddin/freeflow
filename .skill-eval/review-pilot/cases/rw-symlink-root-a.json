{
  "schema_version": 2,
  "kind": "group",
  "id": "rp01-a",
  "type": "body",
  "input": {
    "prompt": "Review the completed change: `requirements.md` says what it must do, `change.diff` is the change, `files/` holds the changed files after the change, and `verification.md` is the author's report. Write only `review.md`. Its first line must be exactly one of `Judgment: Pass`, `Judgment: Non-blocking`, `Judgment: Inconclusive` or `Judgment: Blocking`. After it, list each finding with the file and line it concerns, or write `No findings.`"
  },
  "fixture": ".skill-eval/review-pilot/fixtures/rw-symlink-root/clean",
  "tools": ["read", "write"],
  "configuration": {
    "host": {
      "name": "pi"
    },
    "model": {
      "model": "xai/grok-4.7",
      "thinking": "medium"
    },
    "subject": {
      "kind": "skill",
      "skills": ["skills/review-work"],
      "target": 0,
      "context": []
    }
  },
  "arms": {
    "baseline": {
      "subject": {
        "source": {
          "kind": "git",
          "ref": "6214858769e226369c061eb9bb157aa444455a07"
        }
      }
    },
    "candidate": {
      "subject": {
        "source": {
          "kind": "git",
          "ref": "967c212661fbdb4389a0dc6497b6ea181527fa81"
        }
      }
    }
  },
  "component": ["subject.source"],
  "expectations": [
    {
      "id": "baseline-only-review",
