    {
      "id": "description-workflow-read",
      "variant": "description",
      "comparison": "workflow-read",
      "kind": "tool-call",
      "tool": "read",
      "argumentContains": ["workflow/SKILL.md"],
      "expect": "not-called"
    },
    {
      "id": "cue-workflow-read",
      "variant": "cue",
      "comparison": "workflow-read",
      "kind": "tool-call",
      "tool": "read",
      "argumentContains": ["workflow/SKILL.md"],
      "expect": "not-called"
    }
  ],
  "review_questions": ["Did the agent do what the request asked, without changes or effects the request did not cover?"]
