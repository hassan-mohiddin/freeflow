{
  "schema_version": 2,
  "kind": "group",
  "id": "template-watch",
  "type": "body",
  "input": {
    "prompt": "Start the template watcher (npm run watch) and keep it running while you fix the templates it reports errors for, until it reports every template ok. Then stop the watcher."
  },
  "fixture": ".skill-eval/freeflow-tool-use/fixtures/template-watch",
  "tools": [
    "read",
    "write",
    "edit",
    "ls",
    "find",
    "grep",
    "bash",
    "bash_background",
    "monitor",
    "stop_background",
    "apply_patch"
  ],
  "configuration": {
    "extends": "../configuration.json",
    "environment": {
      "kind": "container",
      "image": "freeflow-tool-use@sha256:16a3f298e47de3cbe8b6b6939ac379cc258cb39cc906c06abd555dc907f35493",
      "workdir": "/testbed",
      "network": "none"
    }
  },
  "arms": {
    "freeflow": {}
  },
  "reference": "freeflow",
  "participants": {
    "protocol": "conversation",
    "user": {
      "model": "anthropic/claude-haiku-5-5",
      "thinking": "low",
      "max_turns": 4,
      "stop": "THANKS, DONE",
      "card": ".skill-eval/freeflow-tool-use/cards/template-watch.md"
    }
  },
  "expectations": [
    {
      "id": "task",
      "kind": "command",
      "variant": "freeflow",
      "argv": ["node", "--test", "--test-reporter=tap", ".ftu-hidden.test.mjs"],
      "files": {
        ".ftu-hidden.test.mjs": ".skill-eval/freeflow-tool-use/graders/template-watch.test.mjs",
        ".ftu-original/data/site.json": ".skill-eval/freeflow-tool-use/graders/originals/template-watch/data/site.json",
        ".ftu-original/tools/compile.js": ".skill-eval/freeflow-tool-use/graders/originals/template-watch/tools/compile.js",
        ".ftu-original/tools/watch.js": ".skill-eval/freeflow-tool-use/graders/originals/template-watch/tools/watch.js"
      },
      "timeout_seconds": 300,
      "pass": {
        "tests": {
          "format": "node-test",
          "required": [
            "ftu: the about page names the bistro and its address",
            "ftu: the menu lists every dish once inside its list",
            "ftu: the home page still builds",
            "ftu: the watcher, compiler and data are unchanged"
          ]
        }
      }
    },
    {
      "id": "tool-monitor",
      "kind": "tool-call",
      "variant": "freeflow",
      "tool": "monitor",
      "expect": "called"
    },
    {
      "id": "tool-stop",
      "kind": "tool-call",
      "variant": "freeflow",
      "tool": "stop_background",
      "expect": "succeeded"
    },
    {
      "id": "tool-background",
      "kind": "tool-call",
      "variant": "freeflow",
      "tool": "bash_background",
      "expect": "called"
    }
  ],
  "review_questions": [],
  "reference_solution": {
    "files": ".skill-eval/freeflow-tool-use/reference/template-watch"
  }
}
