# The freeflow-tool-use script tasks' container: the same toolchain as image/Dockerfile (Node and npm, Python 3, Git,
# tmux, procps and curl) plus the ledger project's history at /opt/project.git (main at release 0.2.0, the CSV export
# work left uncommitted). The history is built here from fixtures/ledger and image/ledger-history, outside the
# workspace (a fixture in this repository cannot hold a .git folder); GIT_DIR and GIT_WORK_TREE point Git at it, so
# `git status`, `git diff`, `git commit` and Freeflow's scripts work in /testbed. A commit lands in the container's
# history and ends with it: graders see the original history. Git's identity is the project owner's, so a commit needs
# no setup. Build with the suite folder as the context (see ../README.md); the layers it shares with image/Dockerfile
# come from the local build cache. Images come from mirror.gcr.io and packages from Ubuntu's archive; the evaluator
# never pulls, so build locally and pin the digest in the groups.
FROM mirror.gcr.io/library/node:22-bookworm-slim AS node
FROM mirror.gcr.io/library/ubuntu:24.04
RUN apt-get update \
 && apt-get install -y --no-install-recommends tmux git procps ca-certificates python3 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && git config --system --add safe.directory '*'
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*
COPY fixtures/ledger /opt/build/head
COPY image/ledger-history /opt/build/history
COPY image/make-history.mjs /opt/build/make-history.mjs
RUN node /opt/build/make-history.mjs /opt/build /opt/project.git && rm -rf /opt/build \
 && git config --system user.name "Sam Rivera" \
 && git config --system user.email "sam@example.com"
ENV GIT_DIR=/opt/project.git GIT_WORK_TREE=/testbed
WORKDIR /testbed
