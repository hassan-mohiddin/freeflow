{
  "schema_version": 2,
  "kind": "group",
  "id": "rv25-b",
  "type": "body",
  "input": {
    "prompt": "Review the completed change in this workspace against what it must do: `change.diff` is the change, `files/` holds the changed files after the change, and `verification.md` is the author's report. Write only `review.md`. Its first line must be exactly one of `Judgment: Pass`, `Judgment: Non-blocking`, `Judgment: Inconclusive` or `Judgment: Blocking`. After it, list each finding with the file and line it concerns, or write `No findings.`"
  },
  "fixture": ".skill-eval/review-suite/fixtures/rs-6cdbdfcf/clean/workspace",
  "tools": ["read", "write", "ls", "find", "run_command"],
  "commands": [
    {
      "id": "tests",
      "argv": ["node", "../../../../../../../.skill-eval/review-suite/tools/run-tests.mjs", "rv25-b"],
      "timeout_ms": 300000
    }
  ],
  "configuration": {
    "extends": "../configuration.json"
  },
  "arms": {
    "baseline": {
      "subject": {
        "context": []
      }
    },
    "candidate": {
      "subject": {
        "context": [".skill-eval/review-suite/context/rv25-b/requirements.md"]
      }
    }
  },
  "component": ["subject.context"],
  "expectations": [
    {
      "id": "baseline-only-review",
      "variant": "baseline",
      "comparison": "only-review",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": ["review.md"]
    },
    {
      "id": "candidate-only-review",
      "variant": "candidate",
      "comparison": "only-review",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": ["review.md"]
    },
    {
      "id": "baseline-judgment-line",
      "variant": "baseline",
      "comparison": "judgment-line",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "contains",
      "value": "Judgment: "
    },
    {
      "id": "candidate-judgment-line",
      "variant": "candidate",
      "comparison": "judgment-line",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "contains",
      "value": "Judgment: "
    },
    {
      "id": "baseline-ran-tests",
      "variant": "baseline",
      "comparison": "ran-tests",
      "kind": "tool-call",
      "tool": "run_command",
      "expect": "called",
      "argumentContains": ["tests"]
    },
    {
      "id": "candidate-ran-tests",
      "variant": "candidate",
      "comparison": "ran-tests",
      "kind": "tool-call",
      "tool": "run_command",
      "expect": "called",
      "argumentContains": ["tests"]
    }
  ],
  "review_questions": [
    "Did the review identify this known issue in the change: Reads in Pi's kept raw tail drop out of every later session-wide file list after Pi compacts, against the commit's own README ('across any mix of Freeflow and Pi compactions'). Reproduced with Pi 1.0.1's prepareCompaction and the commit's harness. Still on main.",
    "Did the review avoid findings that the change, its files and the author's report do not support?"
  ]
}
