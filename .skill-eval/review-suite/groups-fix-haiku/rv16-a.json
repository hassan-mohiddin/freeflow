{
  "schema_version": 2,
  "kind": "group",
  "id": "rv16-a",
  "type": "body",
  "input": {
    "prompt": "Review the completed change in this workspace against what it must do: `change.diff` is the change, `files/` holds the changed files after the change, and `verification.md` is the author's report. Write only `review.md`. Its first line must be exactly one of `Judgment: Pass`, `Judgment: Non-blocking`, `Judgment: Inconclusive` or `Judgment: Blocking`. After it, list each finding with the file and line it concerns, or write `No findings.`"
  },
  "fixture": ".skill-eval/review-suite/fixtures-ra-rb/rv16-a",
  "tools": ["read", "write", "ls", "find", "run_command"],
  "commands": [
    {
      "id": "tests",
      "argv": ["node", "../../../../../../../.skill-eval/review-suite/tools/run-tests.mjs", "rv16-a"],
      "timeout_ms": 600000
    }
  ],
  "configuration": {
    "extends": "../configuration.json"
  },
  "arms": {
    "b": {
      "subject": {
        "context": [".skill-eval/review-suite/context-ra-rb/rv16-a/b.md"]
      }
    },
    "c": {
      "subject": {
        "context": [".skill-eval/review-suite/context-ra-rb/rv16-a/c.md"],
        "skills": [".skill-eval/review-suite/skills-ra-rb/review-work"]
      }
    }
  },
  "reference": "b",
  "component": ["subject.context", "subject.skills"],
  "expectations": [
    {
      "id": "b-only-review",
      "variant": "b",
      "comparison": "only-review",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": ["review.md"]
    },
    {
      "id": "c-only-review",
      "variant": "c",
      "comparison": "only-review",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": ["review.md"]
    },
    {
      "id": "b-judgment-line",
      "variant": "b",
      "comparison": "judgment-line",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "contains",
      "value": "Judgment: "
    },
    {
      "id": "c-judgment-line",
      "variant": "c",
      "comparison": "judgment-line",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "contains",
      "value": "Judgment: "
    },
    {
      "id": "b-not-blocked",
      "variant": "b",
      "comparison": "not-blocked",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "not-contains",
      "value": "Judgment: Blocking"
    },
    {
      "id": "c-not-blocked",
      "variant": "c",
      "comparison": "not-blocked",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "not-contains",
      "value": "Judgment: Blocking"
    },
    {
      "id": "b-not-inconclusive",
      "variant": "b",
      "comparison": "not-inconclusive",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "not-contains",
      "value": "Judgment: Inconclusive"
    },
    {
      "id": "c-not-inconclusive",
      "variant": "c",
      "comparison": "not-inconclusive",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "not-contains",
      "value": "Judgment: Inconclusive"
    },
    {
      "id": "b-judged-pass",
      "variant": "b",
      "comparison": "judged-pass",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "equals",
      "value": "Judgment: Pass"
    },
    {
      "id": "c-judged-pass",
      "variant": "c",
      "comparison": "judged-pass",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "equals",
      "value": "Judgment: Pass"
    }
  ],
  "review_questions": [
    "Did the review avoid reporting problems that the change, its files and the author's report do not support?",
    "Did the review keep style or naming preferences out of its findings?"
  ]
}
