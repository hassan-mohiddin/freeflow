{
  "schema_version": 2,
  "kind": "group",
  "id": "rv10-b",
  "type": "body",
  "input": {
    "prompt": "Review the completed change in this workspace against what it must do: `change.diff` is the change, `files/` holds the changed files after the change, and `verification.md` is the author's report. Write only `review.md`. Its first line must be exactly one of `Judgment: Pass`, `Judgment: Non-blocking`, `Judgment: Inconclusive` or `Judgment: Blocking`. After it, list each finding with the file and line it concerns, or write `No findings.`"
  },
  "fixture": ".skill-eval/review-suite/fixtures-ra-rb/rv10-b",
  "tools": ["read", "write", "ls", "find", "run_command"],
  "commands": [
    {
      "id": "tests",
      "argv": ["node", "../../../../../../../.skill-eval/review-suite/tools/run-tests.mjs", "rv10-b"],
      "timeout_ms": 600000
    }
  ],
  "configuration": {
    "extends": "../configuration-grok.json"
  },
  "arms": {
    "full": {
      "subject": {
        "context": [".skill-eval/review-suite/context-ra-rb/rv10-b/a.md"]
      }
    },
    "pointer": {
      "subject": {
        "context": [".skill-eval/review-suite/context-ra-rb/rv10-b/b.md"]
      }
    },
    "pointer-judge-first": {
      "subject": {
        "context": [".skill-eval/review-suite/context-ra-rb/rv10-b/c.md"]
      }
    }
  },
  "reference": "pointer",
  "component": ["subject.context"],
  "expectations": [
    {
      "id": "full-only-review",
      "variant": "full",
      "comparison": "only-review",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": ["review.md"]
    },
    {
      "id": "pointer-only-review",
      "variant": "pointer",
      "comparison": "only-review",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": ["review.md"]
    },
    {
      "id": "pointer-judge-first-only-review",
      "variant": "pointer-judge-first",
      "comparison": "only-review",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": ["review.md"]
    },
    {
      "id": "full-judgment-line",
      "variant": "full",
      "comparison": "judgment-line",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "contains",
      "value": "Judgment: "
    },
    {
      "id": "pointer-judgment-line",
      "variant": "pointer",
      "comparison": "judgment-line",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "contains",
      "value": "Judgment: "
    },
    {
      "id": "pointer-judge-first-judgment-line",
      "variant": "pointer-judge-first",
      "comparison": "judgment-line",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "contains",
      "value": "Judgment: "
    },
    {
      "id": "full-not-blocked",
      "variant": "full",
      "comparison": "not-blocked",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "not-contains",
      "value": "Judgment: Blocking"
    },
    {
      "id": "pointer-not-blocked",
      "variant": "pointer",
      "comparison": "not-blocked",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "not-contains",
      "value": "Judgment: Blocking"
    },
    {
      "id": "pointer-judge-first-not-blocked",
      "variant": "pointer-judge-first",
      "comparison": "not-blocked",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "not-contains",
      "value": "Judgment: Blocking"
    },
    {
      "id": "full-not-inconclusive",
      "variant": "full",
      "comparison": "not-inconclusive",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "not-contains",
      "value": "Judgment: Inconclusive"
    },
    {
      "id": "pointer-not-inconclusive",
      "variant": "pointer",
      "comparison": "not-inconclusive",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "not-contains",
      "value": "Judgment: Inconclusive"
    },
    {
      "id": "pointer-judge-first-not-inconclusive",
      "variant": "pointer-judge-first",
      "comparison": "not-inconclusive",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "not-contains",
      "value": "Judgment: Inconclusive"
    },
    {
      "id": "full-judged-pass",
      "variant": "full",
      "comparison": "judged-pass",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "equals",
      "value": "Judgment: Pass"
    },
    {
      "id": "pointer-judged-pass",
      "variant": "pointer",
      "comparison": "judged-pass",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "equals",
      "value": "Judgment: Pass"
    },
    {
      "id": "pointer-judge-first-judged-pass",
      "variant": "pointer-judge-first",
      "comparison": "judged-pass",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "equals",
      "value": "Judgment: Pass"
    }
  ],
  "review_questions": [
    "Did the review avoid reporting problems that the change, its files and the author's report do not support?",
    "Did the review keep style or naming preferences out of its findings?"
  ]
}
