{
  "schema_version": 2,
  "kind": "group",
  "id": "f7-01",
  "type": "body",
  "input": {
    "prompt": "Review the completed change in this workspace against what it must do: `change.diff` is the change, `files/` holds the changed files after the change, and `verification.md` is the author's report. Write only `review.md`. Its first line must be exactly one of `Judgment: Pass`, `Judgment: Non-blocking`, `Judgment: Inconclusive` or `Judgment: Blocking`. After it, list each finding with the file and line it concerns, or write `No findings.`"
  },
  "fixture": ".skill-eval/review-suite/fixtures/f7-01/seeded/workspace",
  "tools": ["read", "write", "ls", "find"],
  "configuration": {
    "extends": "../configuration.json"
  },
  "arms": {
    "baseline": {
      "subject": {
        "context": [
          ".skill-eval/review-suite/context-f7/f7-01/a/request.md",
          ".skill-eval/review-suite/context-f7/f7-01/req/requirements.md"
        ]
      }
    },
    "candidate": {
      "subject": {
        "context": [
          ".skill-eval/review-suite/context-f7/f7-01/b/request.md",
          ".skill-eval/review-suite/context-f7/f7-01/req/requirements.md"
        ]
      }
    }
  },
  "component": ["subject.context"],
  "rubric": [
    {
      "id": "found-defect",
      "question": "Did the review identify the planted defect by its location (the file and line, or the defective expression) and its effect? A paraphrase of the defect is fine. A finding about another line or another concern does not count.",
      "reference": {
        "path": ".skill-eval/review-suite/references-f7/f7-01/defect.md"
      }
    }
  ],
  "judges": [
    {
      "model": "anthropic/claude-haiku-5-5",
      "thinking": "high"
    }
  ],
  "expectations": [
    {
      "id": "baseline-only-review",
      "variant": "baseline",
      "comparison": "only-review",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": ["review.md"]
    },
    {
      "id": "candidate-only-review",
      "variant": "candidate",
      "comparison": "only-review",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": ["review.md"]
    },
    {
      "id": "baseline-judgment-line",
      "variant": "baseline",
      "comparison": "judgment-line",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "contains",
      "value": "Judgment: "
    },
    {
      "id": "candidate-judgment-line",
      "variant": "candidate",
      "comparison": "judgment-line",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "contains",
      "value": "Judgment: "
    },
    {
      "id": "baseline-not-pass",
      "variant": "baseline",
      "comparison": "not-pass",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "not-contains",
      "value": "Judgment: Pass"
    },
    {
      "id": "candidate-not-pass",
      "variant": "candidate",
      "comparison": "not-pass",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "not-contains",
      "value": "Judgment: Pass"
    }
  ],
  "review_questions": [
    "Did the review keep to the requested lens, and avoid findings the change, its files and the requirements do not support?",
    "Did the review raise the planted defect at its location, or did it spend its findings on other issues?"
  ]
}
