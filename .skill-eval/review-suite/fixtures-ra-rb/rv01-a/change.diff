+      background: () => [],
+      noticePrefix: "[notice]",
+      coordinatorUnderProjection: () => false,
+      carryEnabled: () => true,
+      nativeRefs: () => assignment !== undefined,
+      assignmentResults: () => undefined,
+      resolveRef: () => undefined,
+      summarize: async () => undefined,
+      measure: () => ({ tokens, thresholds: limits }),
