{
  "schema_version": 2,
  "kind": "group",
  "id": "rv02-a",
  "type": "body",
  "input": {
    "prompt": "Review the completed change in this workspace against what it must do: `change.diff` is the change, `files/` holds the changed files after the change, and `verification.md` is the author's report. Write only `review.md`. Its first line must be exactly one of `Judgment: Pass`, `Judgment: Non-blocking`, `Judgment: Inconclusive` or `Judgment: Blocking`. After it, list each finding with the file and line it concerns, or write `No findings.`"
  },
  "fixture": ".skill-eval/review-suite/fixtures/rs-4ab18f5b/clean/workspace",
  "tools": ["read", "write", "ls", "find", "run_command"],
  "commands": [
    {
      "id": "tests",
      "argv": ["node", "../../../../../../../.skill-eval/review-suite/tools/run-tests.mjs", "rv02-a"],
      "timeout_ms": 600000
    }
  ],
  "configuration": {
    "extends": "../configuration.json"
  },
  "arms": {
    "baseline": {
      "subject": {
        "source": {
          "kind": "git",
          "ref": "266a160ddf7f96572a0b085c2780ec23ea64c7bd"
        },
        "context": [".skill-eval/review-suite/context/rv02-a/requirements.md"]
      }
    },
    "candidate": {
      "subject": {
        "source": {
          "kind": "git",
          "ref": "e6470fafaeb2008a4a93baaf03ef218d8cfc98f4"
        },
        "context": [".skill-eval/review-suite/context/rv02-a/requirements.md"]
      }
    }
  },
  "component": ["subject.source"],
  "expectations": [
    {
      "id": "baseline-only-review",
      "variant": "baseline",
      "comparison": "only-review",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": ["review.md"]
    },
    {
      "id": "candidate-only-review",
      "variant": "candidate",
      "comparison": "only-review",
      "kind": "changed-paths",
      "expect": "equals",
      "paths": ["review.md"]
    },
    {
      "id": "baseline-judgment-line",
      "variant": "baseline",
      "comparison": "judgment-line",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "contains",
      "value": "Judgment: "
    },
    {
      "id": "candidate-judgment-line",
      "variant": "candidate",
      "comparison": "judgment-line",
      "kind": "file-text",
      "path": "review.md",
      "line": 1,
      "expect": "contains",
      "value": "Judgment: "
    },
    {
      "id": "baseline-ran-tests",
      "variant": "baseline",
      "comparison": "ran-tests",
      "kind": "tool-call",
      "tool": "run_command",
      "expect": "called",
      "argumentContains": ["tests"]
    },
    {
      "id": "candidate-ran-tests",
      "variant": "candidate",
      "comparison": "ran-tests",
      "kind": "tool-call",
      "tool": "run_command",
      "expect": "called",
      "argumentContains": ["tests"]
    }
  ],
  "review_questions": [
    "Did the review identify this known issue in the change: persistedBranchMatches compares only the live branch, then trusts every in-memory entry, so an unwritten entry on another branch passes reconcile() unblocked (requirement 3). Reproduced: the control blocks with ancestry_unavailable, the off-branch case does not.",
    "Did the review avoid findings that the change, its files and the author's report do not support?"
  ]
}
