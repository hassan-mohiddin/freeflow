#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  LINK="$(readlink "$SOURCE")"
  if [[ "$LINK" != /* ]]; then
    SOURCE="$DIR/$LINK"
  else
    SOURCE="$LINK"
  fi
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

PI_ROOT="${PIFLOW_PI_ROOT:-/Users/mohammedhassanmohiddin/Documents/Antigravity/pi-mono}"
FREEFLOW_ROOT="${PIFLOW_FREEFLOW_ROOT:-$ROOT}"
AGENT_DIR="${PIFLOW_AGENT_DIR:-$HOME/.piflow/agent}"
SESSION_DIR="${PIFLOW_SESSION_DIR:-$AGENT_DIR/sessions}"

export PIFLOW_PI_ROOT="$PI_ROOT"
export PIFLOW_FREEFLOW_ROOT="$FREEFLOW_ROOT"
export PIFLOW_AGENT_DIR="$AGENT_DIR"
export FREEFLOW_RUNTIME="piflow"

if [[ "${1:-}" == "sync-from-pi" ]]; then
  exec node "$FREEFLOW_ROOT/scripts/piflow.mjs" sync-from-pi "${@:2}"
fi

node "$FREEFLOW_ROOT/scripts/piflow.mjs" --ensure "$@" >/dev/null 2>&1 || {
  echo "PiFlow could not initialize its isolated state. Run: piflow sync-from-pi" >&2
  exit 1
}

mkdir -p "$AGENT_DIR" "$SESSION_DIR"
export PI_CODING_AGENT_DIR="$AGENT_DIR"
export PI_CODING_AGENT_SESSION_DIR="$SESSION_DIR"
unset PI_MODEL PI_PROVIDER PI_REASONING_LEVEL PI_SESSION_FILE PI_SESSION_ID

exec node "$PI_ROOT/packages/coding-agent/dist/cli.js" "$@"
