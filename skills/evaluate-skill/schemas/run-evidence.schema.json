{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freeflow.dev/schemas/skill-eval-run-evidence-v1.json",
  "title": "Freeflow Skill Eval Run Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "skill",
    "case_id",
    "variant",
    "skill_snapshot_hash",
    "host",
    "adapter_version",
    "evidence_classes",
    "fingerprint",
    "started_at",
    "ended_at",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "variant": { "type": "string", "minLength": 1 },
    "skill_snapshot_hash": { "type": ["string", "null"] },
    "host": { "type": "string", "minLength": 1 },
    "host_version": { "type": ["string", "null"] },
    "adapter_version": { "type": "string", "minLength": 1 },
    "provider": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "thinking": { "type": ["string", "null"] },
    "tools": { "type": "array", "items": { "type": "string" } },
    "context_controls": { "type": "object" },
    "invocation": { "type": "object" },
    "evidence_classes": { "type": "object" },
    "fingerprint": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "usage": { "type": ["object", "null"] },
    "artifacts": { "type": "object" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
