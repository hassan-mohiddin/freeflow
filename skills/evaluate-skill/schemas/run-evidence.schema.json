{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freeflow.dev/schemas/skill-eval-run-evidence-v1.json",
  "title": "Freeflow Skill Eval Run Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "skill",
    "case_id",
    "variant",
    "variant_kind",
    "skill_snapshot_hash",
    "host",
    "adapter_version",
    "evidence_classes",
    "fingerprint",
    "runtime_counters",
    "process",
    "started_at",
    "ended_at",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "variant": { "type": "string", "minLength": 1 },
    "variant_kind": { "enum": ["working-tree", "git", "none"] },
    "skill_snapshot_hash": { "type": ["string", "null"] },
    "host": { "type": "string", "minLength": 1 },
    "host_version": { "type": ["string", "null"] },
    "adapter_version": { "type": "string", "minLength": 1 },
    "provider": { "type": ["string", "null"] },
    "backend_model_revision": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "thinking": { "type": ["string", "null"] },
    "tools": { "type": "array", "items": { "type": "string" } },
    "context_controls": { "type": "object" },
    "hard_limits": { "type": "object" },
    "invocation": { "type": "object" },
    "evidence_classes": { "type": "object" },
    "fingerprint": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "usage": { "type": ["object", "null"] },
    "runtime_counters": {
      "type": "object",
      "required": ["provider_requests", "turns_started", "tool_calls", "hard_turn_limit_reached"]
    },
    "activation": { "type": "object" },
    "changed_paths": { "type": "array", "items": { "type": "string" } },
    "assertion_root": { "enum": ["skill", "workspace"] },
    "skill_manifest": { "type": ["object", "null"] },
    "process": { "type": "object" },
    "artifacts": { "type": "object" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
