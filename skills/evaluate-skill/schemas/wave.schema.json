{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freeflow.dev/schemas/skill-eval-wave-v1.json",
  "title": "Freeflow Skill Eval Wave",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "wave_id",
    "wave_root",
    "skill",
    "profile",
    "status",
    "created_at",
    "updated_at",
    "plan",
    "snapshots",
    "fixtures",
    "policy",
    "usage",
    "jobs",
    "pause_reason"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "wave_id": { "type": "string", "minLength": 1 },
    "wave_root": { "type": "string", "minLength": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "profile": { "enum": ["iterate", "acceptance"] },
    "status": { "enum": ["planned", "running", "paused_budget", "paused", "needs_attention", "complete"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "plan": { "type": "object" },
    "snapshots": { "type": "object", "additionalProperties": { "type": "string" } },
    "fixtures": { "type": "object", "additionalProperties": { "type": "string" } },
    "policy": {
      "type": "object",
      "required": ["concurrency", "max_model_requests", "max_usd", "max_turns_per_job", "output_limit_bytes"]
    },
    "usage": {
      "type": "object",
      "required": ["jobs_completed", "model_requests", "spent_usd", "cost_available"]
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "key", "case_id", "variant", "status", "attempts", "run_dir", "runtime_verdict"]
      }
    },
    "pause_reason": { "type": ["string", "null"] },
    "candidate_only_prepared": { "type": "boolean" }
  }
}
