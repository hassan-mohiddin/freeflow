{
  "name": "@hassangameryt/freeflow",
  "version": "0.9.0",
  "description": "Feedback-based control system for coding agents.",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Hassan Mohiddin"
  },
  "homepage": "https://github.com/hassan-mohiddin/freeflow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hassan-mohiddin/freeflow.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache --cache-strategy content",
    "format:pi-extension-dist": "prettier --write pi-extension/dist",
    "build:pi-extension": "node -e \"require('node:fs').rmSync('pi-extension/dist', { recursive: true, force: true })\" && tsc -p pi-extension/tsconfig.json && npm run format:pi-extension-dist",
    "build": "npm run build:pi-extension",
    "typecheck": "tsc -p pi-extension/tsconfig.json --noEmit",
    "lint": "eslint pi-extension/src",
    "check": "npm run typecheck && npm run lint && npm run check:source && npm run check:host-manifests && npm run check:hosts && npm run check:changelog && npm run check:release-workflow && npm run check:docs && npm run check:dev-docs && npm run format:check && npm run check:release-version && npm run check:commands && npm run check:activation && npm run check:runtime && npm run check:package && npm run check:eval-coverage && npm run check:eval-definitions && npm run check:coverage-matrix && npm run check:skill-routing && npm run check:incident-fixtures",
    "check:source": "node scripts/validation/check-source-files.mjs",
    "check:host-manifests": "node scripts/validation/check-host-manifests.mjs",
    "check:hosts": "node scripts/validation/check-hosts.mjs",
    "check:changelog": "node scripts/validation/check-changelog.mjs --structure",
    "check:release-workflow": "node scripts/validation/check-release-workflow.mjs",
    "check:docs": "node scripts/validation/check-docs.mjs",
    "check:dev-docs": "node skills/write-docs/scripts/docs-check.mjs --strict dev-docs",
    "check:release-version": "node scripts/validation/check-release-version.mjs",
    "check:commands": "scripts/validation/audit-command-surface.sh",
    "check:activation": "scripts/validation/check-activation-contract.sh",
    "check:runtime": "hooks/tests/check-runtime-context-hook.sh",
    "check:package": "node scripts/validation/check-package.mjs",
    "check:eval-coverage": "node scripts/validation/check-eval-coverage.mjs --strict",
    "check:eval-definitions": "node scripts/validation/check-eval-definitions.mjs",
    "check:coverage-matrix": "node .skill-eval/scripts/verify-coverage-matrix.mjs",
    "check:skill-routing": "node scripts/validation/check-skill-routing-doc.mjs",
    "check:incident-fixtures": "node .skill-eval/workflow/scripts/verify-incident-fixtures.mjs",
    "check:release-metadata": "scripts/validation/validate-release-metadata.sh --mode prepublish",
    "perf:request": "node scripts/perf/request-overhead.mjs",
    "eval:gate": "node .skill-eval/scripts/gate.mjs",
    "test": "npm run test:pi-extension && npm run test:host-manifests && npm run test:skill-author && npm run test:skill-eval && npm run test:research-work && npm run test:track-work && npm run test:discuss-work && npm run test:execute-work && npm run test:deliver-work && npm run test:review-work && npm run test:verify-work && npm run test:write-docs && npm run test:freeflow-snapshot && npm run test:release-utils && npm run test:release-workflow && npm run test:changelog && npm run test:docs && npm run test:eval-coverage && npm run test:guards",
    "test:pi-extension": "npm run build && node --test $(find pi-extension/tests -name '*.test.js' | sort)",
    "test:host-manifests": "node --test scripts/validation/check-host-manifests.test.mjs scripts/validation/check-hosts.test.mjs hooks/tests/check-host-adapters.test.mjs",
    "test:skill-author": "node --test $(find .skill-eval/write-skill/tests -name '*.test.mjs' | sort)",
    "test:skill-eval": "node --test $(find .skill-eval/evaluate-behavior/tests -name '*.test.mjs' | sort)",
    "test:research-work": "node --test $(find .skill-eval/research-work/tests -name '*.test.mjs' | sort)",
    "test:track-work": "node scripts/validation/with-symlinked-tmp.mjs node --test .skill-eval/track-work/tests/*.test.mjs",
    "test:discuss-work": "node --test .skill-eval/discuss-work/tests/*.test.mjs",
    "test:execute-work": "node --test .skill-eval/execute-work/tests/*.test.mjs",
    "test:deliver-work": "node --test .skill-eval/deliver-work/tests/*.test.mjs",
    "test:review-work": "node --test .skill-eval/review-work/tests/*.test.mjs",
    "test:verify-work": "node --test .skill-eval/verify-work/tests/*.test.mjs",
    "test:write-docs": "node --test .skill-eval/write-docs/tests/*.test.mjs",
    "test:freeflow-snapshot": "node --test scripts/freeflow-snapshot.test.mjs",
    "test:release-utils": "node --test scripts/release-utils.test.mjs",
    "test:changelog": "node --test scripts/validation/check-changelog.test.mjs",
    "test:release-workflow": "node --test scripts/validation/check-release-workflow.test.mjs",
    "test:docs": "node --test scripts/validation/check-docs.test.mjs",
    "test:eval-coverage": "node --test scripts/validation/check-eval-coverage.test.mjs",
    "test:guards": "node --test scripts/validation/guards.test.mjs",
    "release:prepare": "node scripts/release.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "snapshot:refresh": "node scripts/freeflow-snapshot.mjs"
  },
  "keywords": [
    "pi-package",
    "agent-skills",
    "workflow",
    "skills",
    "agents",
    "feedback-loop",
    "task-memory",
    "planning",
    "verification",
    "review",
    "codex",
    "claude",
    "pi",
    "agent-plugins",
    "gemini",
    "cursor",
    "copilot",
    "vscode",
    "kiro",
    "opencode",
    "hermes"
  ],
  "pi": {
    "skills": [],
    "extensions": [
      "pi-extension/freeflow/index.js"
    ],
    "image": "https://raw.githubusercontent.com/hassan-mohiddin/freeflow/main/assets/freeflow-plugin-icon-transparent.png"
  },
  "files": [
    "gemini-extension.json",
    ".agents/**",
    ".claude-plugin/**",
    ".codex-plugin/**",
    ".cursor-plugin/**",
    "com.github.copilot/**",
    "LICENSE",
    "NOTICE",
    "licenses/**",
    "README.md",
    "assets/**",
    "capabilities/**",
    "runtime/**",
    "command-surface.json",
    "hooks/adapters/**",
    "hooks/claude/hooks.json",
    "hooks/claude/freeflow.mjs",
    "hooks/codex/hooks.json",
    "hooks/cursor/hooks.json",
    "hooks/freeflow-runtime-context.mjs",
    "hooks/hooks.json",
    "hooks/shared/runtime-context.mjs",
    "pi-extension/freeflow/**",
    "pi-extension/dist/**",
    "skills/**"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.1",
    "@earendil-works/pi-tui": ">=0.99.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^22.15.30",
    "eslint": "10.12.0",
    "prettier": "3.9.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.71.1"
  },
  "dependencies": {},
  "overrides": {
    "undici": "8.12.3"
  }
}
