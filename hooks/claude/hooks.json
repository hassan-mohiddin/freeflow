{
  "description": "Load Freeflow core runtime context in Claude Code, one hook per prompt: Claude Code caps each hook's context at 10,000 characters.",
  "modules": ["./freeflow.mjs"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/adapters/claude-session-start.mjs\" SessionStart core",
            "timeout": 5,
            "statusMessage": "Loading Freeflow context"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/adapters/claude-session-start.mjs\" SessionStart interactionContract",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/adapters/claude-session-start.mjs\" SessionStart workingMethod",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
